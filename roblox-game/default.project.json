{
  "name": "Coin & Pet Simulator",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "GameConfig": { "$path": "src/ReplicatedStorage/GameConfig.lua" },
      "Remotes": {
        "$className": "Folder",
        "ClickOrb":     { "$className": "RemoteEvent" },
        "SyncData":     { "$className": "RemoteEvent" },
        "Notification": { "$className": "RemoteEvent" },
        "LuckyClick":   { "$className": "RemoteEvent" },
        "PlaySound":    { "$className": "RemoteEvent" },
        "BuyItem":      { "$className": "RemoteFunction" },
        "Rebirth":      { "$className": "RemoteFunction" },
        "HatchReveal":  { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "PlayerData":     { "$path": "src/ServerScriptService/PlayerData.lua" },
      "GameManager":    { "$path": "src/ServerScriptService/GameManager.server.lua" },
      "ClickManager":   { "$path": "src/ServerScriptService/ClickManager.server.lua" },
      "PetManager":     { "$path": "src/ServerScriptService/PetManager.server.lua" },
      "ShopManager":    { "$path": "src/ServerScriptService/ShopManager.server.lua" },
      "RebirthManager": { "$path": "src/ServerScriptService/RebirthManager.server.lua" },
      "MapGenerator":   { "$path": "src/ServerScriptService/MapGenerator.server.lua" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MainUI":        { "$path": "src/StarterPlayer/StarterPlayerScripts/MainUI.client.lua" },
        "ClickHandler":  { "$path": "src/StarterPlayer/StarterPlayerScripts/ClickHandler.client.lua" },
        "SoundManager":  { "$path": "src/StarterPlayer/StarterPlayerScripts/SoundManager.client.lua" },
        "Effects":       { "$path": "src/StarterPlayer/StarterPlayerScripts/Effects.lua" },
        "WelcomeGui":       { "$path": "src/StarterPlayer/StarterPlayerScripts/WelcomeGui.client.lua" },
        "WorldEffects":     { "$path": "src/StarterPlayer/StarterPlayerScripts/WorldEffects.client.lua" },
        "ProximityHandler": { "$path": "src/StarterPlayer/StarterPlayerScripts/ProximityHandler.client.lua" }
      }
    }
  }
}
